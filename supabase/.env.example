# Secretos de las Edge Functions. Copia a supabase/.env (NO se versiona) y súbelos con:
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL y SUPABASE_SECRET_KEYS / SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase: no los pongas aquí
# (los nombres que empiezan por SUPABASE_ están reservados).

# Clave maestra de los dispositivos: openssl rand -hex 32
# Guárdala también en tu gestor de contraseñas: se necesita para aprovisionar cada ESP32.
DEVICE_MASTER_KEY=

# Broker MQTT por WebSocket seguro (lo usan las Edge Functions para publicar comandos)
# HiveMQ Cloud: wss://<cluster>.s1.eu.hivemq.cloud:8884/mqtt
MQTT_URL=
MQTT_USERNAME=acc-publisher
MQTT_PASSWORD=

# Orígenes web permitidos (CORS), separados por coma, sin barra final ni ruta
APP_ORIGIN=https://<usuario>.github.io,http://localhost:5173
